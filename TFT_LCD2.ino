// เรียกใช้ไลบรารี TFT_eSPI สำหรับควบคุมหน้าจอ TFT
#include <TFT_eSPI.h>

// สร้างออบเจ็กต์ชื่อ tft สำหรับควบคุมหน้าจอ
TFT_eSPI tft;

void setup() {

  // เริ่มต้นการทำงานของหน้าจอ TFT
  tft.begin();

  // กำหนดทิศทางการแสดงผลของหน้าจอ
  // ค่า 3 คือหมุนหน้าจอเป็นแนวนอนในทิศทางหนึ่ง
  tft.setRotation(3);

  // ล้างหน้าจอและกำหนดพื้นหลังเป็นสีดำ
  tft.fillScreen(TFT_BLACK);

  // กำหนดสีของตัวอักษรเป็นสีขาว
  tft.setTextColor(TFT_WHITE);

  // กำหนดขนาดตัวอักษร
  // ค่า 2 หมายถึงขนาดตัวอักษรระดับ 2
  tft.setTextSize(2);

  // แสดงข้อความบนหน้าจอ
  // "Hello Wio Terminal" = ข้อความที่ต้องการแสดง
  // 20 = ตำแหน่งแกน X (ซ้ายไปขวา)
  // 30 = ตำแหน่งแกน Y (บนลงล่าง)
  tft.drawString("Hello Wio Terminal", 20, 30);
}

void loop() {

  // ส่วนนี้จะทำงานวนซ้ำตลอดเวลา
  // แต่ในตัวอย่างนี้ยังไม่มีคำสั่งใด ๆ
}
