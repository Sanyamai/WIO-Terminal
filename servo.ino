// เรียกใช้ไลบรารี Servo สำหรับควบคุม Servo Motor
#include <Servo.h>

// เรียกใช้ไลบรารี TFT_eSPI สำหรับควบคุมหน้าจอ TFT
#include <TFT_eSPI.h>


// สร้างออบเจ็กต์ Servo ชื่อ myservo
Servo myservo;

// สร้างออบเจ็กต์สำหรับควบคุมหน้าจอ TFT
TFT_eSPI tft = TFT_eSPI();


void setup() {

  // ==============================
  // ส่วนที่ 1 : เริ่มต้นหน้าจอ TFT
  // ==============================

  // เริ่มต้นการทำงานของหน้าจอ
  tft.begin();

  // กำหนดทิศทางการแสดงผลของหน้าจอ
  // ค่า 3 คือการหมุนหน้าจอ
  tft.setRotation(3);

  // กำหนดสีพื้นหลังหน้าจอเป็นสีดำ
  tft.fillScreen(TFT_BLACK);


  // ==============================
  // ส่วนที่ 2 : ตั้งค่า Servo Motor
  // ==============================

  // เชื่อมต่อ Servo Motor เข้ากับขา BCM9 (D9)
  myservo.attach(BCM9);

  // กำหนดตำแหน่งเริ่มต้นของ Servo ที่ 20 องศา
  // พร้อมแสดงข้อมูลบนหน้าจอ
  showServo(20);
}


void loop() {

  // ==============================
  // ทดสอบ Servo ที่มุม 20 องศา
  // ==============================

  // หมุน Servo ไปที่ 20 องศา
  // และแสดงค่าบนหน้าจอ
  showServo(20);

  // รอ 2 วินาที
  delay(2000);


  // ==============================
  // ทดสอบ Servo ที่มุม 90 องศา
  // ==============================

  // หมุน Servo ไปที่ 90 องศา
  // และแสดงค่าบนหน้าจอ
  showServo(90);

  // รอ 2 วินาที
  delay(2000);


  // ==============================
  // ทดสอบ Servo ที่มุม 170 องศา
  // ==============================

  // หมุน Servo ไปที่ 170 องศา
  // และแสดงค่าบนหน้าจอ
  showServo(170);

  // รอ 2 วินาที
  delay(2000);
}


// =====================================================
// ฟังก์ชัน showServo()
// ใช้สำหรับสั่ง Servo และแสดงข้อมูลบนหน้าจอ TFT
//
// angle = มุมที่ต้องการให้ Servo หมุนไป
// =====================================================

void showServo(int angle) {

  // ==============================
  // ส่วนที่ 1 : สั่ง Servo Motor
  // ==============================

  // สั่งให้ Servo หมุนไปยังมุมที่กำหนด
  // เช่น 20, 90 หรือ 170 องศา
  myservo.write(angle);


  // ==============================
  // ส่วนที่ 2 : ล้างหน้าจอ
  // ==============================

  // ล้างข้อมูลเดิมทั้งหมด
  // และเปลี่ยนพื้นหลังเป็นสีดำ
  tft.fillScreen(TFT_BLACK);


  // ==============================
  // ส่วนที่ 3 : แสดงหัวข้อ
  // ==============================

  // กำหนดสีข้อความเป็นสีฟ้า Cyan
  tft.setTextColor(TFT_CYAN);

  // กำหนดขนาดตัวอักษร
  tft.setTextSize(3);

  // กำหนดตำแหน่งเริ่มต้นของข้อความ
  // X = 30
  // Y = 30
  tft.setCursor(30, 30);

  // แสดงข้อความหัวข้อ
  tft.print("SERVO TEST");


  // ==============================
  // ส่วนที่ 4 : แสดงค่ามุม Servo
  // ==============================

  // กำหนดสีข้อความเป็นสีขาว
  tft.setTextColor(TFT_WHITE);

  // กำหนดขนาดตัวอักษรให้ใหญ่ขึ้น
  tft.setTextSize(5);

  // กำหนดตำแหน่งแสดงค่ามุม
  // X = 70
  // Y = 90
  tft.setCursor(70, 90);

  // แสดงค่ามุม เช่น 20, 90 หรือ 170
  tft.print(angle);

  // แสดงสัญลักษณ์องศา °
  // ASCII 247 คือสัญลักษณ์องศาในชุดอักขระที่ใช้
  tft.print((char)247);

  // แสดงตัวอักษร C
  // หมายเหตุ: ในโค้ดนี้ C หมายถึงตัวอักษร C
  // ไม่ได้หมายถึงหน่วยของ Servo
  tft.print("C");


  // ==============================
  // ส่วนที่ 5 : แสดงสถานะ Servo
  // ==============================

  // เปลี่ยนสีข้อความเป็นสีเขียว
  tft.setTextColor(TFT_GREEN);

  // กำหนดขนาดตัวอักษร
  tft.setTextSize(2);

  // กำหนดตำแหน่งข้อความ
  tft.setCursor(50, 160);

  // แสดงชื่อ Servo และขาที่ใช้งาน
  tft.print("Servo D9");


  // กำหนดตำแหน่งบรรทัดถัดไป
  tft.setCursor(50, 190);

  // แสดงข้อความ "Angle:"
  tft.print("Angle: ");

  // แสดงค่ามุมปัจจุบัน
  tft.print(angle);

  // แสดงหน่วยองศา
  tft.print(" deg");
}
