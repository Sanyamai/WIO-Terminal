#include <TFT_eSPI.h>
// เรียกใช้ Library สำหรับควบคุมหน้าจอ TFT ของ Wio Terminal


// ======================================================
// Wio Terminal + Ultrasonic + LED RYG + TFT
// ======================================================
//
// Ultrasonic HC-SR04
//   TRIG  -> BCM0
//   ECHO  -> BCM1
//
// LED RYG
//   RED    -> BCM2
//   YELLOW -> BCM3
//   GREEN  -> BCM4
//
// การทำงาน
//   ระยะ > 30 cm  = GREEN
//   ระยะ 15-30 cm = YELLOW
//   ระยะ < 15 cm  = RED
//
// ======================================================


// สร้างตัวแปรสำหรับควบคุมหน้าจอ TFT
TFT_eSPI tft = TFT_eSPI();


// ======================================================
// กำหนดขาของ Ultrasonic
// ======================================================

// ขา TRIG ใช้ส่งคลื่น Ultrasonic ออกไป
#define TRIG_PIN BCM0 //ต่อ gpio 0

// ขา ECHO ใช้รับคลื่นที่สะท้อนกลับมา
#define ECHO_PIN BCM1


// ======================================================
// กำหนดขาของ LED RYG
// ======================================================

// LED สีแดง
#define RED_LED BCM2

// LED สีเหลือง
#define YELLOW_LED BCM3

// LED สีเขียว
#define GREEN_LED BCM4


// ======================================================
// SETUP
// ======================================================

void setup() {

  // เปิด Serial Monitor
  // ใช้สำหรับดูค่าระยะทางที่วัดได้
  Serial.begin(115200);


  // ====================================================
  // ตั้งค่าขา Ultrasonic
  // ====================================================

  // TRIG เป็นขาส่งสัญญาณ
  pinMode(TRIG_PIN, OUTPUT);

  // ECHO เป็นขารับสัญญาณ
  pinMode(ECHO_PIN, INPUT);


  // ====================================================
  // ตั้งค่าขา LED
  // ====================================================

  // กำหนดขา LED สีแดงเป็น OUTPUT
  pinMode(RED_LED, OUTPUT);

  // กำหนดขา LED สีเหลืองเป็น OUTPUT
  pinMode(YELLOW_LED, OUTPUT);

  // กำหนดขา LED สีเขียวเป็น OUTPUT
  pinMode(GREEN_LED, OUTPUT);


  // ====================================================
  // เริ่มต้นใช้งาน TFT
  // ====================================================

  // เริ่มต้นระบบหน้าจอ TFT
  tft.begin();

  // กำหนดทิศทางหน้าจอ
  // ค่า 3 = แนวนอน
  tft.setRotation(3);

  // ล้างหน้าจอและกำหนดพื้นหลังเป็นสีดำ
  tft.fillScreen(TFT_BLACK);


  // ====================================================
  // แสดงหัวข้อบนหน้าจอ
  // ====================================================

  // กำหนดสีตัวอักษรเป็นสีขาว
  // และสีพื้นหลังตัวอักษรเป็นสีดำ
  tft.setTextColor(TFT_WHITE, TFT_BLACK);

  // กำหนดตำแหน่งข้อความให้อยู่ตรงกลาง
  tft.setTextDatum(MC_DATUM);

  // แสดงข้อความหัวข้อ
  // 160 = ตำแหน่งแกน X
  // 25  = ตำแหน่งแกน Y
  // 4   = ขนาดตัวอักษร
  tft.drawString(
    "Ultrasonic + LED:RYG",
    160,
    25,
    4
  );


  // ปิด LED ทั้งหมดก่อนเริ่มทำงาน
  allLEDOff();


  // หน่วงเวลา 1 วินาที
  delay(1000);
}


// ======================================================
// LOOP
// ======================================================

void loop() {


  // ====================================================
  // ขั้นตอนที่ 1 : ส่งคลื่น Ultrasonic
  // ====================================================

  // ทำให้ TRIG เป็น LOW ก่อน
  digitalWrite(TRIG_PIN, LOW);

  // รอ 2 ไมโครวินาที
  delayMicroseconds(2);


  // ส่งสัญญาณ HIGH ออกไป
  digitalWrite(TRIG_PIN, HIGH);

  // ค้าง HIGH เป็นเวลา 10 ไมโครวินาที
  // เพื่อสั่งให้ HC-SR04 ส่งคลื่น Ultrasonic
  delayMicroseconds(10);


  // ปิดสัญญาณ TRIG
  digitalWrite(TRIG_PIN, LOW);


  // ====================================================
  // ขั้นตอนที่ 2 : อ่านสัญญาณ ECHO
  // ====================================================

  // pulseIn() ใช้วัดระยะเวลาที่ ECHO เป็น HIGH
  //
  // ECHO_PIN = ขาที่รับสัญญาณ
  // HIGH     = รอช่วงที่สัญญาณเป็น HIGH
  // 30000    = timeout 30,000 ไมโครวินาที
  //
  // ผลลัพธ์ที่ได้คือเวลาในหน่วย microseconds
  long duration = pulseIn(
    ECHO_PIN,
    HIGH,
    30000
  );


  // ====================================================
  // ขั้นตอนที่ 3 : คำนวณระยะทาง
  // ====================================================

  // สร้างตัวแปรสำหรับเก็บระยะทาง
  float distance = 0;


  // ถ้ามีสัญญาณตอบกลับ
  if (duration > 0) {

    // คำนวณระยะทางเป็นเซนติเมตร
    //
    // ความเร็วเสียงประมาณ 0.0343 cm/us
    //
    // ต้องหาร 2 เพราะคลื่นเดินทาง
    // "ไปหาเป้าหมาย + สะท้อนกลับ"
    //
    distance =
      duration * 0.0343 / 2;
  }


  // ====================================================
  // ขั้นตอนที่ 4 : แสดงค่าทาง Serial Monitor
  // ====================================================

  Serial.print("Distance: ");


  // ถ้า duration = 0
  // หมายความว่าไม่พบสัญญาณสะท้อนกลับ
  if (duration == 0) {

    Serial.println("No Object");

  }

  else {

    // แสดงระยะทาง
    Serial.print(distance);

    // แสดงหน่วยเซนติเมตร
    Serial.println(" cm");
  }


  // ====================================================
  // ขั้นตอนที่ 5 : แสดงข้อมูลบน TFT
  // ====================================================

  // ล้างพื้นที่ส่วนแสดงข้อมูล
  //
  // x = 0
  // y = 60
  // width = 320
  // height = 180
  //
  // เพื่อไม่ให้ข้อมูลเก่าค้างอยู่บนหน้าจอ
  tft.fillRect(
    0,
    60,
    320,
    180,
    TFT_BLACK
  );


  // ====================================================
  // แสดงคำว่า DISTANCE
  // ====================================================

  // กำหนดตำแหน่งข้อความให้อยู่ตรงกลาง
  tft.setTextDatum(MC_DATUM);

  // ตัวอักษรสีขาว
  tft.setTextColor(
    TFT_WHITE,
    TFT_BLACK
  );

  // แสดงคำว่า DISTANCE
  tft.drawString(
    "DISTANCE",
    160,
    80,
    2
  );


  // ====================================================
  // กรณีที่ 1 : ไม่พบวัตถุ
  // ====================================================

  if (duration == 0) {

    // ปิด LED ทุกดวง
    allLEDOff();


    // กำหนดสีข้อความเป็นสีขาว
    tft.setTextColor(
      TFT_WHITE,
      TFT_BLACK
    );


    // แสดง --- แทนค่าระยะทาง
    tft.drawString(
      "---",
      160,
      120,
      6
    );


    // แสดงสถานะ NO OBJECT
    tft.drawString(
      "NO OBJECT",
      160,
      175,
      4
    );
  }


  // ====================================================
  // กรณีที่ 2 : ระยะมากกว่า 30 cm
  // สถานะ GREEN
  // ====================================================

  else if (distance > 30) {


    // --------------------------------------------------
    // เปิด LED สีเขียว
    // --------------------------------------------------

    // ปิด LED แดง
    digitalWrite(RED_LED, LOW);

    // ปิด LED เหลือง
    digitalWrite(YELLOW_LED, LOW);

    // เปิด LED เขียว
    digitalWrite(GREEN_LED, HIGH);


    // --------------------------------------------------
    // เตรียมข้อความระยะทาง
    // --------------------------------------------------

    // สร้างตัวแปรสำหรับเก็บข้อความ
    char distanceText[20];


    // แปลงค่าตัวเลขเป็นข้อความ
    //
    // %.1f = แสดงทศนิยม 1 ตำแหน่ง
    //
    // ตัวอย่าง
    // 35.678 -> 35.7 cm
    sprintf(
      distanceText,
      "%.1f cm",
      distance
    );


    // --------------------------------------------------
    // แสดงระยะทางสีเขียว
    // --------------------------------------------------

    tft.setTextColor(
      TFT_GREEN,
      TFT_BLACK
    );

    tft.drawString(
      distanceText,
      160,
      120,
      6
    );


    // --------------------------------------------------
    // แสดงสถานะ GREEN
    // --------------------------------------------------

    tft.setTextColor(
      TFT_GREEN,
      TFT_BLACK
    );

    tft.drawString(
      "GREEN",
      160,
      175,
      4
    );
  }


  // ====================================================
  // กรณีที่ 3 : ระยะ 15-30 cm
  // สถานะ YELLOW
  // ====================================================

  else if (distance > 15) {


    // --------------------------------------------------
    // เปิด LED สีเหลือง
    // --------------------------------------------------

    // ปิด LED แดง
    digitalWrite(RED_LED, LOW);

    // เปิด LED เหลือง
    digitalWrite(YELLOW_LED, HIGH);

    // ปิด LED เขียว
    digitalWrite(GREEN_LED, LOW);


    // --------------------------------------------------
    // เตรียมข้อความระยะทาง
    // --------------------------------------------------

    char distanceText[20];


    // แปลงระยะทางเป็นข้อความ
    sprintf(
      distanceText,
      "%.1f cm",
      distance
    );


    // --------------------------------------------------
    // แสดงระยะทางสีเหลือง
    // --------------------------------------------------

    tft.setTextColor(
      TFT_YELLOW,
      TFT_BLACK
    );

    tft.drawString(
      distanceText,
      160,
      120,
      6
    );


    // --------------------------------------------------
    // แสดงสถานะ YELLOW
    // --------------------------------------------------

    tft.setTextColor(
      TFT_YELLOW,
      TFT_BLACK
    );

    tft.drawString(
      "YELLOW",
      160,
      175,
      4
    );
  }


  // ====================================================
  // กรณีที่ 4 : ระยะน้อยกว่าหรือเท่ากับ 15 cm
  // สถานะ RED
  // ====================================================

  else {


    // --------------------------------------------------
    // เปิด LED สีแดง
    // --------------------------------------------------

    // เปิด LED แดง
    digitalWrite(RED_LED, HIGH);

    // ปิด LED เหลือง
    digitalWrite(YELLOW_LED, LOW);

    // ปิด LED เขียว
    digitalWrite(GREEN_LED, LOW);


    // --------------------------------------------------
    // เตรียมข้อความระยะทาง
    // --------------------------------------------------

    char distanceText[20];


    // แปลงระยะทางเป็นข้อความ
    sprintf(
      distanceText,
      "%.1f cm",
      distance
    );


    // --------------------------------------------------
    // แสดงระยะทางสีแดง
    // --------------------------------------------------

    tft.setTextColor(
      TFT_RED,
      TFT_BLACK
    );

    tft.drawString(
      distanceText,
      160,
      120,
      6
    );


    // --------------------------------------------------
    // แสดงสถานะ RED
    // --------------------------------------------------

    tft.setTextColor(
      TFT_RED,
      TFT_BLACK
    );

    tft.drawString(
      "RED",
      160,
      175,
      4
    );
  }


  // ====================================================
  // หน่วงเวลา 200 มิลลิวินาที
  // ====================================================

  // ทำให้ระบบอ่านค่าใหม่ประมาณ 5 ครั้งต่อวินาที
  delay(200);
}


// ======================================================
// ฟังก์ชันปิด LED ทั้งหมด
// ======================================================

void allLEDOff() {

  // ปิด LED สีแดง
  digitalWrite(RED_LED, LOW);

  // ปิด LED สีเหลือง
  digitalWrite(YELLOW_LED, LOW);

  // ปิด LED สีเขียว
  digitalWrite(GREEN_LED, LOW);
}
